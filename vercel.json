{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.vercel_app:app",
      "functions": {
        "backend/vercel_app.py": {
          "excludeFiles": "{frontend/**,tests/**,tools/**,docs/**,.github/**,data/**}",
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
