# Archaeo-Code settings. Copy to .env in the directory the server is started from, or set
# the same names in the environment. Every line below shows the default; uncomment to change.
# Lists take comma-separated values. The definition is backend/settings.py.

# ---- general
#ARCHAEO_ENVIRONMENT=development        # production requires ARCHAEO_API_TOKEN
#ARCHAEO_DATA_DIR=data                  # graph database, search index, cloned repositories
#ARCHAEO_LOG_LEVEL=INFO

# ---- API
#ARCHAEO_API_TOKEN=                     # when set: Authorization: Bearer <token> on every request but the health check and the API reference
#ARCHAEO_CORS_ORIGINS=                  # only needed when a browser calls the API from another origin
#ARCHAEO_READ_ONLY=false                # refuse ingestion, deletion and telemetry intake
#ARCHAEO_TELEMETRY_ENABLED=true

# ---- ingestion
#ARCHAEO_ALLOWED_GIT_HOSTS=             # e.g. github.com,git.example.com   (empty: any host)
#ARCHAEO_ALLOWED_LOCAL_ROOTS=           # server directories from which local repositories may be analysed
#ARCHAEO_WORKSPACE_DIR=                 # where clones are kept (default: <data dir>/repos)
#ARCHAEO_MAX_FILES=20000
#ARCHAEO_MAX_FILE_BYTES=1500000
#ARCHAEO_MAX_COMMITS=20000
#ARCHAEO_BLAME=true
#ARCHAEO_BLAME_BUDGET_SECONDS=300
#ARCHAEO_GITHUB_ENRICHMENT=true         # fetch pull requests named in commit messages
#ARCHAEO_GITHUB_TOKEN=                  # raises the GitHub rate limit
#ARCHAEO_SEED_DEMO=true                 # add the synthetic demo repository to an empty instance
#ARCHAEO_DEMO_SOURCE=auto               # ingest | snapshot | auto (ingest, or the snapshot where git is missing)

# ---- knowledge graph
#ARCHAEO_GRAPH_BACKEND=sqlite           # sqlite | neo4j
#ARCHAEO_SQLITE_PATH=                   # default: <data dir>/graph.sqlite3
#ARCHAEO_NEO4J_URI=bolt://localhost:7687
#ARCHAEO_NEO4J_USER=neo4j
#ARCHAEO_NEO4J_PASSWORD=
#ARCHAEO_NEO4J_DATABASE=neo4j

# ---- search index
#ARCHAEO_VECTOR_ENABLED=true
#ARCHAEO_VECTOR_BACKEND=auto            # memory | qdrant | auto (qdrant when its client is installed or a URL is set)
#ARCHAEO_QDRANT_URL=                    # empty: embedded Qdrant under <data dir>/qdrant (one process only)
#ARCHAEO_QDRANT_API_KEY=
#ARCHAEO_EMBEDDING_PROVIDER=hashing     # hashing (built in, lexical) | openai (any OpenAI-compatible endpoint)
#ARCHAEO_EMBEDDING_MODEL=text-embedding-3-small
#ARCHAEO_EMBEDDING_BASE_URL=
#ARCHAEO_EMBEDDING_API_KEY=
#ARCHAEO_EMBEDDING_DIMENSION=

# ---- language model (none: answers are reports assembled from graph facts)
#ARCHAEO_LLM_PROVIDER=none              # none | openai | anthropic | ollama
#ARCHAEO_LLM_MODEL=
#ARCHAEO_LLM_API_KEY=
#ARCHAEO_LLM_BASE_URL=                  # any OpenAI-compatible endpoint; ollama defaults to http://localhost:11434/v1
#ARCHAEO_LLM_TEMPERATURE=0.0
#ARCHAEO_LLM_MAX_TOKENS=1500
#ARCHAEO_LLM_TIMEOUT=120

# ---- jobs
#ARCHAEO_JOB_BACKEND=inline             # inline (a thread in the API process) | celery (needs a Qdrant server)
#ARCHAEO_REDIS_URL=redis://localhost:6379/0
